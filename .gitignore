# Secrets
.env
.env.*
!.env.example

# Agent runtime output
run/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.DS_Store

# --- Research data: commit code + run manifests, NOT heavy outputs ---
# LLM response cache (regenerated on demand; can be hundreds of files)
experiments/.cache/
# Applied experiment caches (fetched Wikipedia text, embedding vectors, datasets)
experiments/applied/.wikicache/
experiments/applied/.embcache/
experiments/applied/.data/
# Legacy flat data files (superseded by per-run directories)
experiments/results.csv
experiments/bench/results.csv
experiments/token_growth.csv
experiments/scenarios.json
# Per-run heavy artifacts — keep manifest.yaml + README.md, ignore the rest
experiments/runs/**/prompts.jsonl
experiments/runs/**/results.csv
experiments/runs/**/run.log
experiments/runs/**/figures/

# Node (deck build tooling — pptxgenjs, sharp)
node_modules/

# Large binaries / built decks (keep the deck, ignore strays)
*.pptx
!presentation/founsi-context-engineering.pptx
*.key
