# Copy to .env and fill in only what you use. The offline FakeLLM demo needs NONE of these.

# Which model the harness talks to (litellm format). Examples:
#   gpt-4o-mini
#   claude-3-5-sonnet-20241022
#   gemini/gemini-1.5-pro
#   ollama/llama3.1        (local, free)
HARNESS_MODEL=gpt-4o-mini

# 1 = use offline fixtures for web tools (default). 0 = real web search/fetch.
HARNESS_OFFLINE=1

# Provider keys — set only the one matching HARNESS_MODEL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
